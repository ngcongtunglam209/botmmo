# duy nhat vi feed khong tra ve noi dung chuyen khoan.
ENABLE_PAYMENT_BINANCE_PAY=false
BINANCE_PAY_ID=
# URL feed day du ke ca token, vi du https://sieuthicode.com/historyapibinancev3/<TOKEN>
# Token nam trong path nen no lot vao log truy cap cua moi proxy tren duong di.
BINANCE_PAY_HISTORY_URL=
BINANCE_PAY_TIMEOUT_SECONDS=10
BINANCE_PAY_AMOUNT_DECIMALS=4
BINANCE_PAY_MATCH_LEEWAY_SECONDS=120
VIP_PREMIUM_ICON_ID=5240228673738527951
ADMIN_EMAIL_BACKUP=
GROQ_API_KEY=
GROQ_MODEL=
AI_TEMPERATURE=0.9
WELCOME_VIDEO_URL=
WELCOME_VIDEO_ENABLED=1
WELCOME_VIDEO_FILE_ID=
WELCOME_VIDEO_SEND_TIMEOUT=8.0
PUBLIC_API_URL=
SMTP_HOST=
SMTP_RETRY_ATTEMPTS=3
SMTP_TIMEOUT_SEC=15
PUBLIC_IP_PROBE_URLS=
INSTRUCTION_IMAGE_URL=
REPORT_INSTRUCTION_IMAGE_URL=
LIVE_ORDERS_CHANNEL_ID=0
# Kenh nhan thong bao nhap kho. De 0 de tat; /setstockchannel ghi de luc chay.
STOCK_CHANNEL_ID=0
BOT_USERNAME=

