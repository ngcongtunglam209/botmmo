TELEGRAM_LOGIN_REDIRECT_URI=https://your-domain.example/admin/login/telegram/callback
SENDER_APP_PASSWORD=CHANGE_ME

BANK_ID=MB
BANK_ACCOUNT_NUMBER=
ACCOUNT_NAME=
BANK_API_TIMEOUT_SECONDS=6.0
BANK_REFUND_MIN_AMOUNT=200000

# SePay (webhook la chinh, poll chi la du phong doi soat lai) - xem SETUP_BOT.md muc SePay
ENABLE_PAYMENT_SEPAY=false
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://my.sepay.vn
SEPAY_ACCOUNT_NUMBER=
SEPAY_POLL_LOOKBACK_MINUTES=180
ADMIN_USER_ID=0
ADMIN_USERNAME=
SUPPORT_GROUP_LINK=
REQUIRED_GROUP_ID=0
ENABLE_EMAIL_SENDING=false
SENDER_EMAIL=
API_SERVER_PORT=8080
PUBLIC_API_SCHEME=https
# SQLite writes <db>-wal and <db>-shm next to the database file, and log
# rotation writes bot.log.1/.2/.3 next to the log. Both paths must sit inside a
# mounted directory, never be a single bind-mounted file.
#
# Keep these COMMENTED OUT. The app loads .env with override=True, so an empty
# "DB_PATH=" line erases the value docker-compose sets. Uncomment only to
# override deliberately; the default is the project root.
# DB_PATH=/app/data/database.sqlite
# LOG_FILE=/app/logs/bot.log
# IPs allowed to set X-Forwarded-Proto/-For. Keep "*" while the app port is only
# reachable from the Caddy container; set the proxy IP if you publish the port.
TRUSTED_PROXY_IPS=*
AUTO_PUBLIC_IP_DETECT=true
# --- RPay: cong thanh toan USDT (https://api.rpay.vn/api) ---
ENABLE_PAYMENT_RPAY=true
RPAY_MERCHANT_ID=
RPAY_API_KEY=
RPAY_API_BASE_URL=https://api.rpay.vn/api
# Tuy chon. De trong thi RPay dung vi mac dinh cua cua hang.
RPAY_TOKEN=USDT
RPAY_NETWORK=
RPAY_WALLET_ADDRESS=
# De trong thi bam theo PUBLIC_API_URL + /webhook/rpay. Callback la duong chinh;
# thieu no thi bot van doi soat duoc bang poll GetInvoiceStatus, chi cham hon.
RPAY_CALLBACK_URL=
RPAY_TIMEOUT_SECONDS=15
# Tra thieu bao nhieu USDT thi van chap nhan (phi mang lam hut vai cent).
RPAY_UNDERPAY_TOLERANCE=0.01
USDT_DISPLAY_DECIMALS=2
# Ty gia du phong khi khong lay duoc gia live tu USDT_RATE_SOURCE_URL.
USDT_RATE_VND_PER_USDT=0
USDT_RATE_SOURCE_URL=
BANK_BUTTON_ICON_ID=6201627300170043826
CRYPTO_BUTTON_ICON_ID=5280763862113592324

# --- Binance Pay: khach chuyen thang vao Binance ID cua shop ---
