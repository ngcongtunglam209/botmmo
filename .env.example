# ==============================================================================
#  Mau cau hinh. Copy sang .env roi dien gia tri that.
#
#    cp .env.example .env
#
#  App load .env voi override=True, nen mot dong "KEY=" DE TRONG se ghi de gia
#  tri ma docker-compose/system env da dat. Muon dung mac dinh thi COMMENT dong
#  do lai, dung de trong.
#
#  Luu file nay bang UTF-8 KHONG BOM. BOM se dinh vao ten bien dau tien va lam
#  no khong doc duoc.
# ==============================================================================

# ------------------------------------------------------------------------------
#  BAT BUOC - bot thoat ngay neu thieu
# ------------------------------------------------------------------------------
# BotFather -> /newbot
TELEGRAM_TOKEN=CHANGE_ME
# Khoa cho partner API (header x-api-key). Sinh bang: openssl rand -hex 32
API_SECRET_KEY=CHANGE_ME

# ------------------------------------------------------------------------------
#  WEB ADMIN
# ------------------------------------------------------------------------------
ADMIN_WEB_USERNAME=telegram-admin
# Khoa ky cookie phien admin. BAT BUOC dat co dinh:  openssl rand -hex 32
# De trong thi bot sinh khoa ngau nhien moi lan khoi dong, va moi admin bi
# dang xuat sau mot lan restart.
ADMIN_WEB_SESSION_SECRET=
ADMIN_WEB_SESSION_HOURS=8

# Dang nhap admin bang Telegram (BotFather > Bot Settings > Web Login).
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Phai trung tuyet doi voi Redirect URI da dang ky trong BotFather.
TELEGRAM_LOGIN_REDIRECT_URI=https://your-domain.example/admin/login/telegram/callback

# ------------------------------------------------------------------------------
#  TELEGRAM
# ------------------------------------------------------------------------------
ADMIN_USER_ID=0
ADMIN_USERNAME=
BOT_USERNAME=
SUPPORT_GROUP_LINK=
# Bat buoc tham gia nhom truoc khi dung bot. 0 = tat.
REQUIRED_GROUP_ID=0
# Kenh khoe don hang moi ban duoc. De 0 de tat.
# CANH BAO: bo han dong nay ra khoi .env thi code roi ve mot channel ID cung
# trong config_env.py - moi don hang se dang len kenh cua nguoi khac.
LIVE_ORDERS_CHANNEL_ID=0
# Topic (subchannel) trong group forum. Day la message_thread_id, KHONG phai
# chat_id: no chi co nghia khi di kem LIVE_ORDERS_CHANNEL_ID cua group.
# Lay ca hai so tu link topic: t.me/c/<group>/<topic> -> chat_id la -100<group>.
# De 0 de dang thang vao kenh, hoac vao topic General cua group forum.
LIVE_ORDERS_TOPIC_ID=0
# Kenh nhan thong bao nhap kho. De 0 de tat; /setstockchannel ghi de luc chay.
STOCK_CHANNEL_ID=0
# Topic cho kenh nhap kho. /setstockchannel <chat_id> <topic_id> ghi de luc chay.
# LUU Y: dat /setstockchannel mot lan roi thi bien nay bi bo qua - lenh do luu
# ca kenh lan topic vao bot_settings va thang .env. Xem /stockchannel de biet
# cai nao dang co hieu luc.
STOCK_TOPIC_ID=0
# Hoi cau do khi dang ky de chan bot spam.
REGISTRATION_CHALLENGE_ENABLED=false

# ------------------------------------------------------------------------------
#  NGAN HANG (QR chuyen khoan qua SePay)
# ------------------------------------------------------------------------------
BANK_ID=MB
BANK_ACCOUNT_NUMBER=
ACCOUNT_NAME=
BANK_API_TIMEOUT_SECONDS=6.0
# Chu ky quet doi soat, tinh bang giay. Ap dung cho CA SePay, RPay va Binance Pay.
BANK_CHECK_INTERVAL_SECONDS=15
# Tu khoan nay tro len, khach duoc chon hoan tien ve ngan hang thay vi vao vi.
BANK_REFUND_MIN_AMOUNT=200000

# SePay: webhook la duong chinh, poll chi la du phong doi soat lai.
# Xem SETUP_BOT.md muc SePay.
ENABLE_PAYMENT_SEPAY=false
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://my.sepay.vn
# De trong thi dung BANK_ACCOUNT_NUMBER.
SEPAY_ACCOUNT_NUMBER=
SEPAY_POLL_LOOKBACK_MINUTES=180

# ------------------------------------------------------------------------------
#  RPAY - cong thanh toan USDT (https://api.rpay.vn/api)
# ------------------------------------------------------------------------------
# Bat khi co du ENABLE + MERCHANT_ID + API_KEY.
ENABLE_PAYMENT_RPAY=true
RPAY_MERCHANT_ID=
RPAY_API_KEY=
RPAY_API_BASE_URL=https://api.rpay.vn/api

# De trong thi RPay dung vi mac dinh cua cua hang. Chay
# `curl -X POST https://api.rpay.vn/api/GetNetworks` de xem network dang bat.
RPAY_TOKEN=USDT
# Mot mang duy nhat. Nhan ca danh sach nhu RPAY_NETWORKS, phong khi go thieu S.
RPAY_NETWORK=
# NHIEU VI CUNG LUC: liet ke cac mang, khach se duoc chon luc thanh toan.
# Khoa phai dung y het RPay: bsc / tron / polygon / base / ethereum / arbitrum /
# optimism / avalanche / solana / aptos / kava / scroll / celo / opbnb / sui / ton.
# KHONG phai trc hay pol. Kiem tra bang:
#   curl -s -X POST https://api.rpay.vn/api/GetNetworks
# Bot cung tu doi chieu luc khoi dong va bo khoa sai khoi menu.
# Vi du: RPAY_NETWORKS=bsc,tron,polygon
# De trong thi rot ve RPAY_NETWORK; ca hai trong thi RPay dung vi mac dinh.
RPAY_NETWORKS=
# Chi bat buoc khi cung mot network+token co nhieu vi active ben RPay.
# CHI dung cho cau hinh MOT mang: dia chi cua chain nay khong dung cho chain
# khac, nen khi khai bao nhieu mang gia tri nay bi bo qua.
RPAY_WALLET_ADDRESS=
# Vi rieng cho tung mang, dung khi khai bao nhieu mang ma co mang can chi dinh
# vi cu the. Ten bien theo dung khoa mang, viet hoa:
# RPAY_WALLET_ADDRESS_BSC=
# RPAY_WALLET_ADDRESS_TRON=
# RPAY_WALLET_ADDRESS_POLYGON=

# Callback la duong chinh. De trong thi bam theo PUBLIC_API_URL + /webhook/rpay,
# nen PUBLIC_API_URL phai duoc dat. RPay coi callback_url la bat buoc, thieu no
# thi AddInvoice bi tu choi.
RPAY_CALLBACK_URL=
RPAY_TIMEOUT_SECONDS=15
# Tra thieu bao nhieu USDT thi van chap nhan (phi mang lam hut vai cent).
RPAY_UNDERPAY_TOLERANCE=0.01

# ------------------------------------------------------------------------------
#  NOWPAYMENTS - cong USDT da mang (BEP20, Polygon, ...)
# ------------------------------------------------------------------------------
# Moi don co `order_id` rieng nen khop don truc tiep, khong phai doan theo so
# tien nhu Binance Pay. Bat khi co du ENABLE + API_KEY + IPN_SECRET + CURRENCIES.
ENABLE_PAYMENT_NOWPAYMENTS=false
NOWPAYMENTS_API_KEY=
# Tao trong Dashboard > Payment Settings > Instant Payment Notifications.
# CHI hien day du mot lan luc tao - luu ngay. Thieu no thi moi IPN bi tu choi.
NOWPAYMENTS_IPN_SECRET=
# Ma dong tien khach duoc phep tra, lay tu:
#   curl -H "x-api-key: <key>" https://api.nowpayments.io/v1/merchant/coins
# Vi du: usdtbsc,usdtmatic   (Polygon van mang ma MATIC, khong phai POL)
NOWPAYMENTS_CURRENCIES=
# Dong ma so du quy ve. De trong = settle cung dong khach tra (khong quy doi,
# khong phi chuyen doi).
NOWPAYMENTS_PAYOUT_CURRENCY=
NOWPAYMENTS_BASE_URL=
NOWPAYMENTS_TIMEOUT_SECONDS=15
# Tra thieu bao nhieu USDT thi van chap nhan (phi mang lam hut vai cent).
NOWPAYMENTS_UNDERPAY_TOLERANCE=0.01

# ------------------------------------------------------------------------------
#  BINANCE PAY - khach chuyen thang vao Binance ID cua shop
# ------------------------------------------------------------------------------
# Khong co callback: doi soat bang cach poll GET /sapi/v1/pay/transactions.
# Binance khong tra ve noi dung chuyen khoan nen don duoc khop theo SO TIEN duy
# nhat, khong phai ma ICLD. Bat khi co du ENABLE + PAY_ID + API_KEY + API_SECRET.
ENABLE_PAYMENT_BINANCE_PAY=false
BINANCE_PAY_ID=
# API key/secret cua chinh tai khoan Binance nhan tien. Tai khoan CA NHAN la du,
# khong can merchant/giay phep kinh doanh.
# Tao tai Binance > Account > API Management:
#   - CHI bat "Enable Reading". Khong bat withdraw, khong bat trading.
#   - Whitelist IP cua VPS.
# Secret chi hien mot lan luc tao; luu ngay.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# De trong = https://api.binance.com. Doi sang https://api-gcp.binance.com hoac
# api1..api4.binance.com neu duong mang toi api.binance.com chap chon.
BINANCE_API_BASE_URL=
BINANCE_PAY_TIMEOUT_SECONDS=10
# Binance tu choi request co timestamp lech qua nguong nay (loi -1021). Giu NTP
# chay tren VPS; noi rong so nay chi la vá tam.
BINANCE_PAY_RECV_WINDOW_MS=5000
# So chu so thap phan dung de tach don. 4 chu so cho 99 khe moi muc gia; het khe
# thi bot tu choi tao don chu khong cap trung so tien.
BINANCE_PAY_AMOUNT_DECIMALS=4
# Giao dich duoc coi la cua don neu roi trong [tao don - X, het han + X] giay.
BINANCE_PAY_MATCH_LEEWAY_SECONDS=120

# ------------------------------------------------------------------------------
#  TY GIA USDT
# ------------------------------------------------------------------------------
# San pham niem yet VND con hai cong tren deu thu USDT, nen luon can quy doi.
# So le USDT hien cho khach.
USDT_DISPLAY_DECIMALS=2
# Bang gia cong khai, cache 5 phut. De trong thi dung bang quang cao P2P Binance.
USDT_RATE_SOURCE_URL=
# Ty gia du phong khi khong lay duoc gia live. NEN DAT: de 0 ma nguon live chet
# thi moi hoa don crypto se loi.
USDT_RATE_VND_PER_USDT=0
# Ty gia du phong CNY/USDT, chi dung de HIEN THI gia cho khach dung tieng Trung
# (vi -> VND, en -> USD, zh -> CNY kem USD). Khong duong thanh toan nao thu CNY.
USDT_RATE_CNY_PER_USDT=7.2

# ------------------------------------------------------------------------------
#  VI NGUOI DUNG (tien nap chi de mua hang, khong rut ra duoc)
# ------------------------------------------------------------------------------
# Nguong duoi/tren van tinh bang VND; khach EN/ZH thay va go so tien bang
# USD/CNY, bot tu quy doi theo ty gia o tren.
MIN_USER_TOPUP_AMOUNT=10000
MAX_USER_TOPUP_AMOUNT=20000000
USER_TOPUP_EXPIRATION_SECONDS=900

# ------------------------------------------------------------------------------
#  EMAIL
# ------------------------------------------------------------------------------
# Bat cai nay thi SENDER_APP_PASSWORD thanh bat buoc.
ENABLE_EMAIL_SENDING=false
SENDER_EMAIL=
# Gmail: App Password 16 ky tu, khong phai mat khau tai khoan.
SENDER_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_RETRY_ATTEMPTS=3
SMTP_TIMEOUT_SEC=20
# Nhan ban sao lu du lieu dinh ky.
ADMIN_EMAIL_BACKUP=

# ------------------------------------------------------------------------------
#  AI (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.9

# ------------------------------------------------------------------------------
#  API SERVER / MANG
# ------------------------------------------------------------------------------
API_SERVER_PORT=8080
PUBLIC_API_SCHEME=https
# Base URL cong khai. Callback RPay bam theo day. Vi du https://shop.example
PUBLIC_API_URL=
# Tu do IP public khi PUBLIC_API_URL de trong.
AUTO_PUBLIC_IP_DETECT=true
PUBLIC_IP_PROBE_URLS=
# IP duoc phep dat X-Forwarded-Proto/-For. Giu "*" khi cong app chi Caddy goi
# toi duoc; dat IP proxy neu ban publish cong ra ngoai.
TRUSTED_PROXY_IPS=*
# Cho partner API doc X-Forwarded-For de rate limit theo IP that.
API_TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
#  GIAO DIEN
# ------------------------------------------------------------------------------
BANK_BUTTON_ICON_ID=6201627300170043826
CRYPTO_BUTTON_ICON_ID=5280763862113592324
VIP_PREMIUM_ICON_ID=5240228673738527951
REPORT_INSTRUCTION_IMAGE_URL=
WELCOME_VIDEO_ENABLED=1
WELCOME_VIDEO_URL=
# Telegram file_id, nhanh hon tai lai URL moi lan /start.
WELCOME_VIDEO_FILE_ID=
WELCOME_VIDEO_SEND_TIMEOUT=8.0

# ------------------------------------------------------------------------------
#  DUONG DAN VA CO CHAY
# ------------------------------------------------------------------------------
# SQLite ghi them <db>-wal va <db>-shm canh file database, con log xoay vong ghi
# bot.log.1/.2/.3 canh file log. Ca hai duong dan phai nam trong mot THU MUC da
# mount, khong bao gio la mot file bind-mount don le.
#
# GIU NGUYEN TRANG THAI COMMENT. App load .env voi override=True nen mot dong
# "DB_PATH=" de trong se xoa gia tri docker-compose da dat. Chi bo comment khi
# co y ghi de; mac dinh la goc project.
# DB_PATH=/app/data/database.sqlite
# LOG_FILE=/app/logs/bot.log
# Tu chay pip install requirements.txt luc khoi dong. Docker da cai san.
# AUTO_INSTALL=0
# Tat banner ASCII luc khoi dong (dung cho test/CI).
# DINO_SUPPRESS_START_BANNER=0
